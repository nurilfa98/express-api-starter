{
    "compilerOptions": {
        "paths": {
            "@routes/*": ["./src/routes/*"],
            "@models/*": ["./src/models/*"],
            "@controllers/*": ["./src/controllers/*"],
            "@middlewares/*": ["./src/middlewares/*"],
            "@constants/*": ["./src/constants/*"],
            "@utils/*": ["./src/utils/*"],
            "@schemas/*": ["./src/schemas/*"],
            "@services/*": ["./src/services/*"],
            "@config/*": ["./src/config/*"]
        }
    },
    "exclude": ["node_modules"]
}