{
    "name": "express-api-starter",
    "version": "1.0.0",
    "description": "Boilerplate REST API Express.js yang modular dan siap pakai untuk produksi, dilengkapi penanganan error global terpusat (exception management), serta penerapan pola clean architecture.",
    "main": "app.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "nodemon app.js"
    },
    "keywords": [],
    "author": "nurilfa",
    "license": "ISC",
    "packageManager": "pnpm@10.4.1",
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "module-alias": "^2.2.3",
        "mysql2": "^3.14.1",
        "redis": "^5.5.6",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "nodemon": "^3.1.10"
    },
    "_moduleAliases": {
        "@routes": "src/routes",
        "@models": "src/models",
        "@controllers": "src/controllers",
        "@middlewares": "src/middlewares",
        "@constants": "src/constants",
        "@utils": "src/utils",
        "@schemas": "src/schemas",
        "@services": "src/services",
        "@config": "src/config"
    }
}
